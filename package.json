    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-rc.1",
    "@deepseek-ai/dsh-web": "0.1.2-rc.1",
    "@deepseek-ai/dsh-webhook": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "packageManager": "pnpm@11.19.0"
}
